{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/principles.md"
  ],
  "agent": {
    "orchestrator": {
      "description": "Ponto de entrada único. Classifica a tarefa e decide o fluxo (simples ou completo).",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/orchestrator.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "spec-writer": "allow",
          "spec-reviewer": "allow",
          "spec-executor": "allow",
          "code-reviewer": "allow"
        }
      }
    },
    "spec-writer": {
      "description": "Planeja e escreve specs. Não modifica código do projeto.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/spec-writer.md}",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/specs/**": "allow"
        },
        "bash": "deny"
      }
    },
    "spec-reviewer": {
      "description": "Revisa specs com hard gates + SMART. Devolve feedback ou aprova. Edita apenas a linha status: do frontmatter da spec corrente.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/spec-reviewer.md}",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/specs/**": "allow"
        },
        "bash": "deny"
      }
    },
    "spec-executor": {
      "description": "Executa specs com status approved. Implementa código, roda testes, registra outcome.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/spec-executor.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow"
      }
    },
    "code-reviewer": {
      "description": "Revisa código após execução. Edita apenas a linha status: do frontmatter e a seção Code Review da spec corrente.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/code-reviewer.md}",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/specs/**": "allow"
        },
        "bash": "deny"
      }
    }
  }
}
